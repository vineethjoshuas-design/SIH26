# ==============================================================================
# AEGIS-CAD // Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the application:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# [OPTIONAL] Google Gemini API Key
# Used for: Zero-shot multi-lingual LLM distress triage and multimodal image analysis.
# Fallback: If left blank or invalid, AEGIS-CAD automatically activates its
#           embedded, deterministic regex & gazetteer rule engine with zero downtime.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Google Maps API Key
# Used for: Live distance matrix routing, turn-by-turn ETA, and dynamic POI discovery.
# Fallback: If left blank or invalid, AEGIS-CAD seamlessly falls back to its
#           built-in tactical Tamil Nadu gazetteer, Haversine routing, and pre-seeded POIs.
# Obtain a key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# [NETWORK & SERVER]
# Host binding and network port for the FastAPI/Uvicorn server
HOST=127.0.0.1
PORT=8000

